# Скопіюйте у .env або задайте змінні в панелі хостингу. Файл .env не потрапляє в репозиторій.
PORT=3000
# Шлях до файлу бази SQLite (на хмарній платформі — каталог із постійним диском)
DB_FILE=./data/scentfromv.db
# Токен адміністратора для /admin.html і CRUD товарів. Згенеруйте довгий випадковий рядок:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=
